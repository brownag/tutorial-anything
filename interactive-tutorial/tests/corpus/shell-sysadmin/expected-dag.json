      "action_type": "mutate",
      "status": "pending",
      "commit_sha": null,
      "artifacts": [],
      "commands": ["mkdir -p \"$HOME/.config/greet\"\ncp greet.conf.example \"$HOME/.config/greet/greet.conf\""],
      "verification": {"type": "command", "command": "test -f \"$HOME/.config/greet/greet.conf\"", "expect_exit": 0},
      "side_effects": ["user"],
      "undo": ["rm -f \"$HOME/.config/greet/greet.conf\""]
    },
    {
      "id": "check-config",
      "title": "Check the config contents",
      "summary": "Confirm the installed config has name=Ada.",
      "dependencies": ["write-config"],
      "action_type": "read-only",
      "status": "pending",
      "commit_sha": null,
      "artifacts": [],
      "commands": [],
      "verification": {"type": "command", "command": "grep -q '^name=Ada$' \"$HOME/.config/greet/greet.conf\"", "expect_exit": 0}
    },
    {
      "id": "install-bin",
      "title": "Install the greet command",
      "summary": "Write an executable script to $HOME/.local/bin/greet.",
      "dependencies": [],
      "action_type": "mutate",
      "status": "pending",
      "commit_sha": null,
      "artifacts": [],
      "commands": ["mkdir -p \"$HOME/.local/bin\"\ncat > \"$HOME/.local/bin/greet\" <<'EOF'\n#!/bin/sh\nname=$(sed -n 's/^name=//p' \"$HOME/.config/greet/greet.conf\")\necho \"hello, $name\"\nEOF\nchmod +x \"$HOME/.local/bin/greet\""],
      "verification": {"type": "command", "command": "test -x \"$HOME/.local/bin/greet\"", "expect_exit": 0},
      "side_effects": ["user"],
      "undo": ["rm -f \"$HOME/.local/bin/greet\""]
    },
    {
