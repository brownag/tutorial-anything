  "nodes": [
    {
      "id": "scaffold",
      "title": "Create the site page",
      "summary": "Write site/index.html.",
      "dependencies": [],
      "action_type": "mutate",
      "status": "pending",
      "commit_sha": null,
      "artifacts": ["site/index.html"],
      "commands": ["mkdir -p site && echo '<h1>hello</h1>' > site/index.html"],
      "verification": {"type": "file_exists", "path": "site/index.html"}
    },
    {
      "id": "serve",
      "title": "Start the server",
      "summary": "Run the static server on a free port and leave it running.",
      "dependencies": ["scaffold"],
      "action_type": "execute",
      "status": "pending",
      "commit_sha": null,
      "artifacts": [],
      "commands": [],
      "service": {
        "command": "python3 -m http.server {{PORT}} --bind 127.0.0.1 --directory site",
        "ready": {"type": "port_listening", "port": "{{PORT}}"},
        "ready_timeout": 30,
        "stop_signal": "TERM"
      },
      "verification": {"type": "port_listening", "port": "{{PORT}}"}
    },
    {
      "id": "check",
      "title": "Check the page over HTTP",
      "summary": "Fetch the page from the running server.",
      "dependencies": ["serve"],
      "action_type": "read-only",
      "status": "pending",
      "commit_sha": null,
      "artifacts": [],
      "commands": [],
      "verification": {"type": "http", "url": "http://127.0.0.1:{{PORT}}/", "expect_status": 200}
    },
    {
      "id": "stop",
      "title": "Stop the server",
      "summary": "Press Ctrl-C in the server terminal.",
      "dependencies": ["check"],
      "action_type": "execute",
      "status": "pending",
      "commit_sha": null,
      "artifacts": [],
      "commands": [],
      "verification": {"type": "command", "command": "python3 -c \"import socket,sys; s=socket.socket(); sys.exit(0 if s.connect_ex(('127.0.0.1', {{PORT}})) else 1)\""}
    }
  ]
